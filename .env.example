# Quotex Signal Bot configuration — copy to .env and edit.
# Every variable is optional; defaults shown as comments.
# NOTE: keep comments on their own lines (python-dotenv mishandles inline
# comments on empty values, e.g. QSB_ASSET_ALLOWLIST=# foo).

# ---- Broker ---------------------------------------------------------------
# simulated | quotex (live). quotex requires credentials below AND the live
# client module; start with simulated until you've validated the ladder.
QSB_BROKER_MODE=simulated

# RNG seed for the simulated price path.
QSB_SEED=0
# Account balance the simulated broker starts with.
QSB_STARTING_BALANCE=10000
# Payout multiplier on a win (0.85 = 85%).
QSB_PAYOUT_PCT=0.85
# Accelerate simulated expiries (1.0 = real time; >1 for tests/smoke).
QSB_TIME_SCALE=1.0

# ---- Telegram ingestion ---------------------------------------------------
# Bot token from @BotFather. Empty = no Telegram polling (engine still runs).
QSB_TELEGRAM_TOKEN=

# Comma-separated chat IDs allowed to feed signals. With allowlist enabled and
# this empty, ALL chats are denied (safe default — nothing gets traded).
QSB_ALLOWED_CHAT_IDS=
# Gate signal ingestion by the chat ids above.
QSB_ALLOWLIST_ENABLED=true

# ---- Risk -----------------------------------------------------------------
# Level-0 stake.
QSB_BASE_AMOUNT=10
# Gale stake multiplier.
QSB_MARTINGALE_MULTIPLIER=2.0
# Hard cap on ladder length after the entry.
QSB_MAX_GALES=2
# Per-trade stake cap.
QSB_MAX_STAKE=100
# 0 = unlimited cumulative stake across one ladder.
QSB_MAX_LADDER_STAKE=0
# Stop trading once realized daily losses reach this.
QSB_MAX_DAILY_LOSS=200
# Open-position cap.
QSB_MAX_CONCURRENT_POSITIONS=3

# Comma list, e.g. USD/IDR,EUR/USD. Empty = all assets.
QSB_ASSET_ALLOWLIST=
# Min gap between NEW signals on the same asset.
QSB_COOLDOWN_SECONDS=5
# Signals later than this many seconds past their entry time are skipped.
QSB_ENTRY_TOLERANCE_SECONDS=60

# Shift parsed signal entry times by this many hours before scheduling.
# e.g. 4 means a signal saying 08:50 is treated as 12:50 on this machine's clock.
QSB_ENTRY_TIME_OFFSET=0

# Ignore re-forwards of the same scheduled signal within this window (seconds).
QSB_SIGNAL_DEDUP_WINDOW_S=600

# ---- Persistence / logging ------------------------------------------------
QSB_DB_PATH=data/bot.db
QSB_LOG_LEVEL=INFO
QSB_SNAPSHOT_INTERVAL_S=60

# ---- Live Quotex (ONLY used when QSB_BROKER_MODE=quotex) -------------------
# Account type to connect as: demo | live. Keep demo until the ladder is proven.
QSB_QUOTEX_MODE=demo

# Email/password for automated login. Primary flow is pyquotex-style httpx
# (Firefox TLS fingerprint); if the account has 2FA enabled the bot sends the
# OTP prompt to Telegram and waits for your reply there. Fallbacks:
# cloudscraper, then Playwright.
QSB_EMAIL=
QSB_PASSWORD=

# Proxy for the login HTTP flow when Cloudflare blocks your IP (403s).
# Format: http://user:pass@host:port  or  socks5://host:port
QSB_QUOTEX_PROXY=

# Session tokens pasted from your browser. Simplest path: grab the token from
# the Quotex trading page (window.settings.token) — one per account type, or
# a single QSB_SSID that the bot uses for whatever mode it connects as.
QSB_SSID=
QSB_DEMO_SSID=
QSB_LIVE_SSID=

# Optional WebSocket override (empty = modern default in broker/protocol.py).
QSB_WS_URL=

# ---- Userbot group monitor (optional) ---------------------------------------
# Reads signals from private Telegram groups the bot can't be added to, by
# logging in as YOUR personal Telegram account (Telethon/MTProto). Leave
# QSB_MONITOR_LINK empty to disable. Comma-separate multiple links/groups.
#
#   * Get api_id + api_hash at https://my.telegram.org -> API development tools.
#   * QSB_MONITOR_PHONE is the account's phone in international format.
#   * On first run the bot prints "Please enter the code you received" — enter
#     the Telegram login code from the app. A session file is then stored at
#     QSB_MONITOR_SESSION so later restarts log in automatically.
#   * WARNING: this keeps your personal account connected for automation and
#     Telegram may flag/ban it. Prefer a spare account when possible.
QSB_MONITOR_LINK=
QSB_MONITOR_API_ID=0
QSB_MONITOR_API_HASH=
QSB_MONITOR_PHONE=
QSB_MONITOR_SESSION=data/userbot.session
